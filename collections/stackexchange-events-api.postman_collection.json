      "name": "Events",
      "description": {
        "content": "Recent network events (1.5 minute live window) for the authenticated user.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "6a74c621-07fd-40d6-81b1-eedb243591ce",
          "name": "Stack Exchange List Events",
          "request": {
            "name": "Stack Exchange List Events",
            "description": {
              "content": "Recent network events (last ~15 seconds) for the authenticated user.\nRequires authentication.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "events"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "site",
                  "value": "stackoverflow",
                  "description": "(Required) Target Q&A community. Either the api_site_parameter from a `/sites` entry (e.g. `stackoverflow`, `serverfault`, `superuser`) or a full domain (`stackoverflow.com`)."
                },
                {
                  "disabled": false,
                  "key": "access_token",
                  "value": "<string>",
                  "description": "OAuth 2.0 access token. Required for any /me surface and any write."
                },
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "App key from stackapps.com. Raises the daily quota to 10,000/IP."
                },
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>",
                  "description": "Custom response filter id created via /filters/create."
                },
                {
                  "disabled": false,
                  "key": "since",
                  "value": "<long>"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "read_inbox no_expiry write_access private_info"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://stackoverflow.com/oauth/access_token"
                },
                {
                  "key": "authUrl",
                  "value": "https://stackoverflow.com/oauth"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            }
          },
          "response": [
            {
              "id": "86eb7fd1-c919-4eb6-b2c6-bd6ade251291",
              "name": "A page of events.",
