          "name": "Stack Exchange Invalidate Access Tokens",
          "request": {
            "name": "Stack Exchange Invalidate Access Tokens",
            "description": {
              "content": "Invalidate the given access tokens. Requires the app's `key`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "access-tokens",
                ":accessTokens",
                "invalidate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "App key from stackapps.com. Raises the daily quota to 10,000/IP."
                },
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>",
                  "description": "Custom response filter id created via /filters/create."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "accessTokens",
                  "description": "(Required) Up to 100 semicolon-delimited access tokens to invalidate."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
