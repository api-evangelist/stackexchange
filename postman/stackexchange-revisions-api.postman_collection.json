                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "revisions",
                        ":ids"
                      ],
                      "query": [
                        {
                          "description": "(Required) Target Q&A community. Either the api_site_parameter from a `/sites` entry (e.g. `stackoverflow`, `serverfault`, `superuser`) or a full domain (`stackoverflow.com`).",
